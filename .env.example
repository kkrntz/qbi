# Copy this file to .env.local and adjust as needed. .env.local is gitignored
# and takes precedence over this file, so it's safe to put real values there.

# Port the dev/production server listens on. Next.js reads this natively
# (no app code needed) if you don't pass -p/--port explicitly.
# PORT=3000

# Where club, session, and user data is stored. Relative paths resolve
# against the project root; absolute paths are used as-is. Useful for a
# mounted volume in a container, or a separate directory per facility.
# DATA_DIR=.data

# Secret used to sign login session cookies. If unset, one is generated and
# saved to .data/auth-secret on first run, so this is only worth setting
# explicitly if you want logins to survive wiping .data (e.g. restoring from
# a backup that doesn't include auth-secret) or you're running more than one
# server instance against the same DATA_DIR and want them to share secrets.
# AUTH_SECRET=
